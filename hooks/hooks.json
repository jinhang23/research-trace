{
  "description": "Durably stage Claude Code events and transcript deltas for explicitly bound projects only, then hand completed main turns to one reusable forked Recorder. Central upload is done by the independent trace-deliver process, never by this hook.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--protocol",
              "${CLAUDE_PLUGIN_ROOT}/hooks/RECORDER_PROTOCOL.md",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}",
              "--recorder-fork-window",
              "${user_config.recorder_fork_window}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--protocol",
              "${CLAUDE_PLUGIN_ROOT}/hooks/RECORDER_PROTOCOL.md",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}",
              "--recorder-fork-window",
              "${user_config.recorder_fork_window}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--protocol",
              "${CLAUDE_PLUGIN_ROOT}/hooks/RECORDER_PROTOCOL.md",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}",
              "--recorder-fork-window",
              "${user_config.recorder_fork_window}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--protocol",
              "${CLAUDE_PLUGIN_ROOT}/hooks/RECORDER_PROTOCOL.md",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}",
              "--recorder-fork-window",
              "${user_config.recorder_fork_window}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--protocol",
              "${CLAUDE_PLUGIN_ROOT}/hooks/RECORDER_PROTOCOL.md",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}",
              "--recorder-fork-window",
              "${user_config.recorder_fork_window}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--protocol",
              "${CLAUDE_PLUGIN_ROOT}/hooks/RECORDER_PROTOCOL.md",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}",
              "--recorder-fork-window",
              "${user_config.recorder_fork_window}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
