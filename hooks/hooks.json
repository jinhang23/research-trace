{
  "description": "Durably stage visible Claude Code events and transcript deltas for explicitly bound projects. Independent trace-deliver and trace-recorder processes handle upload and semantic recording without waking or blocking the main agent.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
