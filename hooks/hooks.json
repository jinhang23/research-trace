            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--protocol",
              "${CLAUDE_PLUGIN_ROOT}/hooks/RECORDER_PROTOCOL.md",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}",
              "--recorder-fork-window",
              "${user_config.recorder_fork_window}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--protocol",
              "${CLAUDE_PLUGIN_ROOT}/hooks/RECORDER_PROTOCOL.md",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}",
              "--recorder-fork-window",
              "${user_config.recorder_fork_window}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--protocol",
              "${CLAUDE_PLUGIN_ROOT}/hooks/RECORDER_PROTOCOL.md",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}",
              "--recorder-fork-window",
              "${user_config.recorder_fork_window}"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${user_config.python}",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/trace_hook.py",
              "--data-dir",
              "${CLAUDE_PLUGIN_DATA}",
              "--protocol",
              "${CLAUDE_PLUGIN_ROOT}/hooks/RECORDER_PROTOCOL.md",
              "--capture-enabled",
              "${user_config.capture}",
              "--url",
              "${user_config.url}",
              "--recorder-fork-window",
              "${user_config.recorder_fork_window}"
            ],
