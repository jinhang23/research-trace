[Unit]
Description=trace — 科研记录与溯源
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trace
Group=trace
WorkingDirectory=/srv/trace
ExecStart=/srv/trace/.venv/bin/python trace_cli.py serve --host 127.0.0.1 --port 8100 --log-level warning
Restart=always
RestartSec=3

Environment=PYTHONUNBUFFERED=1
# git push 需要 ~/.ssh 与 ~/.gitconfig。把 HOME 指到 /srv/trace，
# 这样 ProtectHome 可以保持开启，同时 git 仍然能读到凭据。
Environment=HOME=/srv/trace

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# 代码目录 + data_dir 指向的数据目录，两个都要可写。
# 数据目录必须可写不只是为了 note.md：写入用的跨进程锁是
# projects/<项目>/.trace-lock，锁不上会退化成无锁，两个写入者就会撞 id。
# 锁刻意不放 /tmp —— PrivateTmp=true 让每个服务看到的是各自的 /tmp，
# 放那儿的锁在真实部署里根本锁不住别的进程。
ReadWritePaths=/srv/trace /srv/trace-data

[Install]
WantedBy=multi-user.target
